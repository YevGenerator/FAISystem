# Config for server with id 1 and fully named params

let uint32 devId = 1
let uint32 serv1 = 3
let uint32 serv2 = 2

device devId
workers 2
ip <host=192.168.0.241 port=7779>

sensor <deviceId=devId id=21>
sensor <deviceId=devId id=22>
sensor <deviceId=devId id=23>
sensor <deviceId=devId id=24>

sensor <deviceId=serv1 id=11>
sensor <deviceId=serv1 id=12>
sensor <deviceId=serv1 id=13>
sensor <deviceId=serv1 id=14>
sensor <deviceId=serv2 id=31>
sensor <deviceId=serv2 id=32>
sensor <deviceId=serv2 id=4>

let AlgoType sno = "2SNO"
let KgInput defaultInput = <c_i="up" a_i=0.75 b_i=0 v_i=0.1 g_i=0.5>
let KgInput upInput = <c_i="up" a_i=0.75 b_i=0 v_i=0.1 g_i=1>
let []KgInput upInputs = [upInput upInput]
let KgInput defReInput = <c_i="down" a_i=0.75 b_i=0 v_i=0.1 g_i=0.5>
let KgInput quoInput = <c_i="up" a_i=0.75 b_i=0 v_i=0.1 g_i=0.5>
let KgInput trInput = <c_i="up" a_i=0.75 b_i=0 v_i=0.01 g_i=0.33>
let []KgInput defInputs = [defaultInput defaultInput ]
let KgOutput defOutput = <c="up" a=0.85>

node <deviceId=devId id=1.4 algo=sno output=defOutput inputs=defInputs>
node <deviceId=devId id=1.5 algo=sno output=defOutput inputs=defInputs>
node <deviceId=devId id=1.6 algo=sno output=defOutput inputs=defInputs>
node <deviceId=devId id=1.7 algo=sno output=defOutput inputs=defInputs>

node <deviceId=devId id=2.3 algo=sno output=defOutput inputs=[ defaultInput defReInput ]>
node <deviceId=devId id=2.4 algo=sno output=defOutput inputs=[ defReInput defaultInput ]>
node <deviceId=devId id=3.1 algo=sno output=defOutput inputs=defInputs>
node <deviceId=devId id=3.2 algo=sno output=defOutput inputs=defInputs>
node <deviceId=devId id=3.3 algo=sno output=defOutput inputs=[quoInput quoInput quoInput <c_i="down" a_i=0.75 b_i=0 v_i=0.1 g_i=0.25> ]>
node <deviceId=devId id=3.4 algo=sno output=defOutput inputs=[ <c_i="up" a_i=0.75 b_i=0 v_i=0.1 g_i=0.33> trInput trInput ]>
node <deviceId=devId id=4.1 algo=sno output=defOutput inputs=upInputs>
node <deviceId=devId id=4.2 algo=sno output=defOutput inputs=upInputs>
node <deviceId=devId id=5.1 algo=sno output=defOutput inputs=defInputs>
node <deviceId=devId id=5.2 algo=sno output=defOutput inputs=defInputs>

node <deviceId=serv1 id=1.1 algo=sno output=defOutput inputs=defInputs>
node <deviceId=serv1 id=1.2 algo=sno output=defOutput inputs=defInputs>
node <deviceId=serv1 id=1.3 algo=sno output=defOutput inputs=[defaultInput ]>
node <deviceId=serv1 id=2.1 algo=sno output=defOutput inputs=[defaultInput defaultInput defaultInput]>
node <deviceId=serv1 id=2.2 algo=sno output=defOutput inputs=defInputs>
node <deviceId=serv1 id=3.0 algo=sno output=defOutput inputs=defInputs>

# example of serv1
bind <from=<deviceId=serv1 id=0.11> to=[<deviceId=serv1 id=1.1 in=0>]>
bind <from=<deviceId=serv1 id=0.12> to=[<deviceId=serv1 id=1.1 in=1>]>
bind <from=<deviceId=serv1 id=0.13> to=[<deviceId=serv1 id=1.2 in=0>]>
bind <from=<deviceId=serv1 id=0.14> to=[<deviceId=serv1 id=1.2 in=1> <deviceId=serv1 id=1.3 in=0>]>
bind <from=<deviceId=serv1 id=1.1> to=[<deviceId=serv1 id=2.1 in=0>]>
bind <from=<deviceId=serv1 id=0.12> to=[<deviceId=serv1 id=2.1 in=1>]>
bind <from=<deviceId=serv1 id=1.2> to=[<deviceId=serv1 id=2.1 in=2> <deviceId=serv1 id=2.2 in=0>]>
bind <from=<deviceId=serv1 id=1.3> to=[<deviceId=serv1 id=2.2 in=1>]>

bind <from=<deviceId=serv1 id=2.1> to=[<deviceId=serv1 id=3.0 in=0> <deviceId=devId id=3.1 in=0> <deviceId=devId id=3.3 in=0>]>
bind <from=<deviceId=serv1 id=2.2> to=[<deviceId=devId id=3.2 in=0> <deviceId=devId id=3.4 in=0>]>

bind <from=<deviceId=devId id=0.21> to=[<deviceId=devId id=1.4 in=0> <deviceId=devId id=1.5 in=0>]>
bind <from=<deviceId=devId id=0.22> to=[<deviceId=devId id=1.4 in=1> <deviceId=devId id=1.5 in=1>]>
bind <from=<deviceId=devId id=0.23> to=[<deviceId=devId id=1.6 in=0>]>
bind <from=<deviceId=devId id=0.24> to=[<deviceId=devId id=1.6 in=1>]>
bind <from=<deviceId=devId id=1.4> to=[<deviceId=devId id=2.3 in=0> <deviceId=devId id=2.4 in=0>]>
bind <from=<deviceId=devId id=1.5> to=[<deviceId=devId id=2.3 in=1> <deviceId=devId id=2.4 in=1>]>
bind <from=<deviceId=devId id=1.6> to=[<deviceId=devId id=3.3 in=0> <deviceId=devId id=3.4 in=2>]>
bind <from=<deviceId=devId id=1.7> to=[<deviceId=devId id=3.3 in=2> <deviceId=serv1 id=3.0 in=1>]>
bind <from=<deviceId=devId id=2.3> to=[<deviceId=devId id=3.1 in=1> <deviceId=devId id=3.4 in=1>]>
bind <from=<deviceId=devId id=2.4> to=[<deviceId=devId id=3.2 in=1> <deviceId=devId id=3.3 in=1>]>
bind <from=<deviceId=devId id=3.1> to=[<deviceId=devId id=4.1 in=0>]>
bind <from=<deviceId=devId id=3.2> to=[<deviceId=devId id=4.1 in=1>]>
bind <from=<deviceId=devId id=3.3> to=[<deviceId=devId id=4.2 in=0>]>
bind <from=<deviceId=devId id=3.4> to=[<deviceId=devId id=4.2 in=1>]>
bind <from=<deviceId=devId id=4.1> to=[<deviceId=devId id=5.1 in=0>]>
bind <from=<deviceId=devId id=4.2> to=[<deviceId=devId id=5.2 in=0>]>

bind <from=<deviceId=serv2 id=0.31> to=[<deviceId=devId id=1.7 in=0>]>
bind <from=<deviceId=serv2 id=0.32> to=[<deviceId=devId id=1.7 in=1>]>

bind <from=<deviceId=serv2 id=0.4> to=[<deviceId=devId id=5.1 in=1> <deviceId=devId id=5.2 in=1>]>

run <deviceId=devId toRun=true>
run <deviceId=serv1 toRun=true>
run <deviceId=serv2 toRun=true>
