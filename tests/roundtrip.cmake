if(NOT DEFINED COMPILER OR NOT DEFINED DECOMPILER OR NOT DEFINED SOURCE OR NOT DEFINED OUTPUT_DIR)
  message(FATAL_ERROR "Missing roundtrip arguments")
endif()
set(binary "${OUTPUT_DIR}/roundtrip.bin")
set(text "${OUTPUT_DIR}/roundtrip.rpconfig")

execute_process(COMMAND "${COMPILER}" "${SOURCE}" "${binary}"
  RESULT_VARIABLE compiler_rc OUTPUT_VARIABLE compiler_out ERROR_VARIABLE compiler_err)
if(NOT compiler_rc EQUAL 0)
  message(FATAL_ERROR "Compiler failed: ${compiler_rc}\n${compiler_out}\n${compiler_err}")
endif()
execute_process(COMMAND "${DECOMPILER}" "${binary}" "${text}"
  RESULT_VARIABLE decompiler_rc OUTPUT_VARIABLE decompiler_out ERROR_VARIABLE decompiler_err)
if(NOT decompiler_rc EQUAL 0)
  message(FATAL_ERROR "Decompiler failed: ${decompiler_rc}\n${decompiler_out}\n${decompiler_err}")
endif()
file(READ "${text}" roundtrip_text)
foreach(keyword "device" "workers" "sensor" "node" "bindE" "run")
  string(FIND "${roundtrip_text}" "${keyword}" index)
  if(index EQUAL -1)
    message(FATAL_ERROR "Missing ${keyword} in decompiled output:\n${roundtrip_text}")
  endif()
endforeach()
message(STATUS "Compiler/decompiler roundtrip succeeded")
